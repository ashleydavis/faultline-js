{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "src/testing.ts"]
}
